  <MdxScripts>
    <MdxScript dwd:design-time-name="802e4bc1-8646-40bc-a56e-24a92b4209fb">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>2021-06-30T19:48:44.613333Z</CreatedTimestamp>
      <LastSchemaUpdate>2022-01-15T12:52:09.47Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;   
CREATE MEMBER CURRENTCUBE.[Measures].[Importo Totale Ordini]
 AS SUM({[Documenti].[ID Profilo 1].&amp;[ORDCLI]}, [Importo Totale]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti';   
CREATE MEMBER CURRENTCUBE.[Measures].[Importo Ordini Nuove Vendite]
 AS SUM({[Macro Tipologia].[Is Valida Per Budget Nuove Vendite 1].&amp;[True]}, [Importo Totale Ordini]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti';   
CREATE MEMBER CURRENTCUBE.[Measures].[Importo Ordini Rinnovi]
 AS SUM({[Macro Tipologia].[Is Valida Per Budget Rinnovi 1].&amp;[True]}, [Importo Totale Ordini]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti';   
CREATE MEMBER CURRENTCUBE.[Measures].[% Scostamento Budget Nuove Vendite]
 AS CASE WHEN [Importo Budget Nuove Vendite] &gt; 0.0 THEN DIVIDE([Importo Ordini Nuove Vendite], [Importo Budget Nuove Vendite]) - 1 END, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Budget';   
CREATE MEMBER CURRENTCUBE.[Measures].[% Scostamento Budget Rinnovi]
 AS CASE WHEN [Importo Budget Rinnovi] THEN DIVIDE([Importo Ordini Rinnovi], [Importo Budget Rinnovi]) - 1 END, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Budget';   
CREATE MEMBER CURRENTCUBE.[Measures].[% Scostamento Budget]
 AS CASE WHEN [Importo Budget] &gt; 0.0 THEN DIVIDE(([Importo Ordini Nuove Vendite] + [Importo Ordini Rinnovi]), [Importo Budget]) - 1 END, 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Budget'; 
CREATE MEMBER CURRENTCUBE.[Measures].[Importo Provvigione Totale]
 AS [Importo Provvigione Capo Area] + [Importo Provvigione Agente] + [Importo Provvigione Subagente], 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Provvigione Capo Area]
 AS DIVIDE([Importo Provvigione Capo Area], [Importo Totale]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Provvigione Agente]
 AS DIVIDE([Importo Provvigione Agente], [Importo Totale]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Provvigione Subagente]
 AS DIVIDE([Importo Provvigione Subagente], [Importo Totale]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Provvigione Totale]
 AS DIVIDE([Importo Provvigione Totale], [Importo Totale]), 
FORMAT_STRING = "Percent", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Documenti'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
