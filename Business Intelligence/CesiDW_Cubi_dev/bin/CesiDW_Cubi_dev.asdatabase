CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Numero Pagine Visitate - A.P.]
 AS (PARALLELPERIOD([Data].[Anno - Mese].[Anno], 1, [Data].[Anno - Mese].CURRENTMEMBER), [Numero Pagine Visitate]),
FORMAT_STRING = "#,###",
VISIBLE = 0 ,  ASSOCIATED_MEASURE_GROUP = 'Accessi'; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Delta Numero Pagine Visitate]
 AS CASE WHEN DIVIDE([Numero Pagine Visitate], [Numero Pagine Visitate - A.P.]) &lt;&gt; 0 THEN DIVIDE([Numero Pagine Visitate], [Numero Pagine Visitate - A.P.]) - 1 END,
FORMAT_STRING = "Percent",
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Accessi'; 
CREATE MEMBER CURRENTCUBE.[Measures].[Numero Giorni Accesso - A.P.]
 AS (PARALLELPERIOD([Data].[Anno - Mese].[Anno], 1, [Data].[Anno - Mese].CURRENTMEMBER), [Numero Giorni Accesso]),
FORMAT_STRING = "#,###",
VISIBLE = 0 ,  ASSOCIATED_MEASURE_GROUP = 'Accessi - Conteggio'; 
CREATE MEMBER CURRENTCUBE.[Measures].[% Delta Numero Giorni Accesso]
 AS CASE WHEN DIVIDE([Numero Giorni Accesso], [Numero Giorni Accesso - A.P.]) &lt;&gt; 0 THEN DIVIDE([Numero Giorni Accesso], [Numero Giorni Accesso - A.P.]) - 1 END,
FORMAT_STRING = "Percent",
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Accessi - Conteggio'; 
</Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
      <ProactiveCaching>
        <SilenceInterval>-PT1S</SilenceInterval>
        <Latency>-PT1S</Latency>
        <SilenceOverrideInterval>-PT1S</SilenceOverrideInterval>
        <ForceRebuildInterval>-PT1S</ForceRebuildInterval>
        <Source xsi:type="ProactiveCachingInheritedBinding" />
      </ProactiveCaching>
