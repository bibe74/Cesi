  <DataSets>
    <DataSet Name="usp_ReportUtilizzoOpenAI">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CapoArea">
            <Value>=Parameters!CapoArea.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PKDataConversazioneInizio">
            <Value>=Parameters!PKDataConversazioneInizio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PKDataConversazioneFine">
            <Value>=Parameters!PKDataConversazioneFine.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC Fact.usp_ReportUtilizzoOpenAI @CapoArea = @CapoArea,
                                   @PKDataConversazioneInizio = @PKDataConversazioneInizio,
                                   @PKDataConversazioneFine = @PKDataConversazioneFine;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Email">
          <DataField>Email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CodiceCliente">
          <DataField>CodiceCliente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RagioneSociale">
          <DataField>RagioneSociale</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IDThread">
          <DataField>IDThread</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IDConversazione">
          <DataField>IDConversazione</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PKDataConversazione">
          <DataField>PKDataConversazione</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Data_Conversazione">
          <DataField>Data Conversazione</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Area">
          <DataField>Area</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ModalitaRisposta">
          <DataField>ModalitaRisposta</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Modello">
          <DataField>Modello</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IDVectorStorage">
          <DataField>IDVectorStorage</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InputTokens">
          <DataField>InputTokens</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="OutputTokens">
          <DataField>OutputTokens</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ReasoningTokens">
          <DataField>ReasoningTokens</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="TotalTokens">
          <DataField>TotalTokens</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="EstimatedTotalCostUSD">
          <DataField>EstimatedTotalCostUSD</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="pCapoArea">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ADUser">
            <Value>=Parameters!ADUser.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT
    GA.CapoArea,
    GA.CapoArea AS CapoAreaDescrizione

FROM Fact.Documenti D
INNER JOIN Dim.GruppoAgenti GA ON GA.PKGruppoAgenti = D.PKGruppoAgenti
    AND GA.CapoArea &lt;&gt; N''
INNER JOIN Bridge.ADUserCapoArea AUCA ON AUCA.CapoArea = GA.CapoArea
    AND AUCA.ADUser = @ADUser
WHERE D.PKDataCompetenza &gt;= CAST('20200101' AS DATE)

UNION ALL SELECT NULL, N'Tutti'
FROM Import.Amministratori A
WHERE A.ADUser = @ADUser

ORDER BY GA.CapoArea;</CommandText>
      </Query>
      <Fields>
        <Field Name="CapoArea">
          <DataField>CapoArea</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CapoAreaDescrizione">
          <DataField>CapoAreaDescrizione</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="pYesterday">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <CommandText>SELECT DATEADD(DAY, -1, CAST(CURRENT_TIMESTAMP AS DATE)) AS Yesterday</CommandText>
      </Query>
      <Fields>
        <Field Name="Yesterday">
          <DataField>Yesterday</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
