<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="CesiDW_ds">
      <DataSourceReference>CesiDW_ds</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>b5cdb6a6-f530-497f-9895-a333e6d45d0f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="usp_ReportAnalytics">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CapoArea">
            <Value>=Parameters!CapoArea.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PKDataVisitaInizio">
            <Value>=Parameters!PKDataVisitaInizio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PKDataVisitaFine">
            <Value>=Parameters!PKDataVisitaFine.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC Fact.usp_ReportAnalytics @CapoArea = @CapoArea,
                              @PKDataVisitaInizio = @PKDataVisitaInizio,
                              @PKDataVisitaFine = @PKDataVisitaFine;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Email">
          <DataField>Email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CodiceCliente">
          <DataField>CodiceCliente</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RagioneSociale">
          <DataField>RagioneSociale</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Data_visita">
          <DataField>Data visita</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Percorso">
          <DataField>Percorso</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Numero_visite">
          <DataField>Numero visite</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="pCapoArea">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ADUser">
            <Value>=Parameters!ADUser.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT
    GA.CapoArea,
    GA.CapoArea AS CapoAreaDescrizione

FROM Fact.Documenti D
INNER JOIN Dim.GruppoAgenti GA ON GA.PKGruppoAgenti = D.PKGruppoAgenti
    AND GA.CapoArea &lt;&gt; N''
INNER JOIN Bridge.ADUserCapoArea AUCA ON AUCA.CapoArea = GA.CapoArea
    AND AUCA.ADUser = @ADUser
WHERE D.PKDataCompetenza &gt;= CAST('20200101' AS DATE)

UNION ALL SELECT NULL, N'Tutti'
FROM Import.Amministratori A
WHERE A.ADUser = @ADUser

ORDER BY GA.CapoArea;</CommandText>
      </Query>
      <Fields>
        <Field Name="CapoArea">
          <DataField>CapoArea</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CapoAreaDescrizione">
          <DataField>CapoAreaDescrizione</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="pYesterday">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <CommandText>SELECT DATEADD(DAY, -1, CAST(CURRENT_TIMESTAMP AS DATE)) AS Yesterday</CommandText>
      </Query>
      <Fields>
        <Field Name="Yesterday">
          <DataField>Yesterday</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
