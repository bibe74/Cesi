  <DataSets>
    <DataSet Name="usp_ReportCreditiMIA">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@CapoArea">
            <Value>=Parameters!CapoArea.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC Fact.usp_ReportCreditiMIA @CapoArea = @CapoArea;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Email">
          <DataField>Email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Codice_ordine">
          <DataField>Codice ordine</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
