          <DataField>Data creazione partita</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Data_scadenza_partita">
          <DataField>Data scadenza partita</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Data_inizio_demo">
          <DataField>Data inizio demo</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="pCapoArea">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <CommandText>SELECT DISTINCT
    GA.CapoArea,
    GA.CapoArea AS CapoAreaDescrizione

FROM Dim.GruppoAgenti GA
WHERE GA.PKGruppoAgenti &gt; 0

UNION ALL SELECT NULL, N'Tutti'

ORDER BY CapoArea;</CommandText>
      </Query>
      <Fields>
        <Field Name="CapoArea">
          <DataField>CapoArea</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CapoAreaDescrizione">
          <DataField>CapoAreaDescrizione</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
