  <DataSets>
    <DataSet Name="usp_ReportDomandeMIA">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC Fact.usp_ReportDomandeMIA
    @StartDate = @StartDate,
    @EndDate = @EndDate;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PKDataCreazione">
          <DataField>PKDataCreazione</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
