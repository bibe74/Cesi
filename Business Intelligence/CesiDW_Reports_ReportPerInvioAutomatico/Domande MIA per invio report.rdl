        </Field>
        <Field Name="Email">
          <DataField>Email</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="pDataInizioFine">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <CommandText>SELECT DATEADD(DAY, -8, CONVERT(DATE, CURRENT_TIMESTAMP)) AS StartDate,
        DATEADD(DAY, -1, CONVERT(DATE, CURRENT_TIMESTAMP)) AS EndDate;
</CommandText>
      </Query>
      <Fields>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
