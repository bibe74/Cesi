  <DataSets>
    <DataSet Name="usp_ReportCruscottoClienti">
      <Query>
        <DataSourceName>CesiDW_ds</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PKDataFinePeriodo">
            <Value>=Parameters!PKDataFinePeriodo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@CapoArea">
            <Value>=Parameters!CapoArea.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@HasAbbonamentoMySolution">
            <Value>=Parameters!HasAbbonamentoMySolution.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@HasAbbonamentoMIA">
            <Value>=Parameters!HasAbbonamentoMIA.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC Fact.usp_ReportCruscottoClienti
    @PKDataFinePeriodo = @PKDataFinePeriodo,
    @CapoArea = @CapoArea,
    @HasAbbonamentoMySolution = @HasAbbonamentoMySolution,
    @HasAbbonamentoMIA = @HasAbbonamentoMIA;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
